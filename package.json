{
  "name": "music-library-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:web": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "assets:audio": "node scripts/generate-demo-audio.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run && npm run test:server",
    "format": "prettier --write .",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "prestart": "npm run db:migrate",
    "start": "node dist-server/server/index.js",
    "db:generate": "prisma generate",
    "db:configure": "node scripts/configure-database.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "checkout:reconcile": "tsx server/reconcile.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "library:import": "tsx server/import-assets.ts",
    "library:grant-preview": "tsx server/grant-preview.ts",
    "library:personal-link": "tsx server/personal-link.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "lucide-react": "^1.61.0",
    "mercadopago": "^3.6.1",
    "motion": "^14.5.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
