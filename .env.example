# URL pública da raiz do site quando houver hospedagem.
# Deixe vazio durante o desenvolvimento local.
# Usada apenas para canonical, og:url e URL absoluta da imagem Open Graph.
VITE_PUBLIC_SITE_URL=

# Frontend: only public configuration. API uses same origin by default.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend only. Never prefix these with VITE_.
# Set NODE_ENV=production in the hosting runtime.
DATABASE_URL=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SELLER_ID=
MERCADO_PAGO_MODE=test
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=music-library
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_LINK_ENCRYPTION_KEY=
# Open only after configuring providers, commercial materials and test validation.
CHECKOUT_ENABLED=false
PORT=3001
HOST=127.0.0.1
