{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/index.html", "destination": "/", "permanent": true }],
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/biblioteca", "destination": "/en/app.html" },
    { "source": "/en/playlist", "destination": "/en/app.html" },
    { "source": "/en/checkout/partitura", "destination": "/en/app.html" },
    { "source": "/en/checkout/:status(success|pending|failure)", "destination": "/en/app.html" },
    { "source": "/en/repertorio-para-violino", "destination": "/en/repertorio-para-violino.html" },
    {
      "source": "/en/partituras-guiadas-para-violino",
      "destination": "/en/partituras-guiadas-para-violino.html"
    },
    {
      "source": "/en/partituras-para-violino/:slug([a-z0-9-]+)",
      "destination": "/en/partituras-para-violino/:slug.html"
    },
    { "source": "/biblioteca", "destination": "/app.html" },
    { "source": "/playlist", "destination": "/app.html" },
    { "source": "/checkout/partitura", "destination": "/app.html" },
    { "source": "/checkout/success", "destination": "/app.html" },
    { "source": "/checkout/pending", "destination": "/app.html" },
    { "source": "/checkout/failure", "destination": "/app.html" },
    { "source": "/repertorio-para-violino", "destination": "/repertorio-para-violino.html" },
    {
      "source": "/partituras-guiadas-para-violino",
      "destination": "/partituras-guiadas-para-violino.html"
    },
    { "source": "/partituras-para-violino", "destination": "/partituras-para-violino.html" },
    { "source": "/violin-sheet-music", "destination": "/violin-sheet-music.html" },
    {
      "source": "/partituras-para-violino/:slug([a-z0-9-]+)",
      "destination": "/partituras-para-violino/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
