{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/index.html", "destination": "/", "permanent": true }],
  "rewrites": [
    { "source": "/biblioteca", "destination": "/app.html" },
    { "source": "/checkout/success", "destination": "/app.html" },
    { "source": "/checkout/pending", "destination": "/app.html" },
    { "source": "/checkout/failure", "destination": "/app.html" },
    { "source": "/repertorio-para-violino", "destination": "/repertorio-para-violino.html" },
    {
      "source": "/partituras-guiadas-para-violino",
      "destination": "/partituras-guiadas-para-violino.html"
    },
    { "source": "/partituras-para-violino", "destination": "/partituras-para-violino.html" },
    {
      "source": "/partituras-para-violino/:slug([a-z0-9-]+)",
      "destination": "/partituras-para-violino/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
