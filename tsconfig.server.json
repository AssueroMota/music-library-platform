{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": ["server/**/*.ts", "prisma/seed.ts", "shared/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "server/test/**"]
}
